rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Accès réservé aux comptes Google du domaine @sarange.fr (email vérifié).
    function isSarange() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('(?i).*@sarange[.]fr');
    }

    match /users/{userId}/quotes/{quoteId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/clients/{clientId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /commandes/{commandeId} {
      allow read, write: if isSarange();
    }

    match /commandes_corbeille/{trashId} {
      allow read, write: if isSarange();
    }
  }
}
